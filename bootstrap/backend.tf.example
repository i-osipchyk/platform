# After the first (local-state) apply: cp backend.tf.example backend.tf, then
#   terraform init -migrate-state \
#     -backend-config="bucket=tfstate-$(aws sts get-caller-identity --query Account --output text)-$AWS_REGION" \
#     -backend-config="region=$AWS_REGION"
# (with AWS_REGION exported, default eu-west-1). Bootstrap state then lives next to every project's.
terraform {
  backend "s3" {
    key          = "platform/bootstrap.tfstate"
    use_lockfile = true
    encrypt      = true
  }
}
