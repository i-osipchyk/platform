# Copy to terraform.tfvars (gitignored). Add a project here before its first CI deploy.
# Region: not set here. It comes from AWS_REGION (export TF_VAR_region="$AWS_REGION"),
# defaulting to eu-west-1.
github_owner = "i-osipchyk"
alert_email  = "" # budget alerts

projects = {
  gtb      = { repo = "gold-tokyo-breakout", budget_usd = 10 }
  bondhype = { repo = "polymarket-bond-hype", envs = ["live"], budget_usd = 10 }
  ags      = { repo = "ags-trading-agentic-system", envs = ["live"], budget_usd = 15 }
}

# Fresh account: the cost allocation tags can only be activated once AWS has seen them.
# activate_cost_allocation_tags = false

# The account's shared cTrader token refresher. Seed /platform/shared/ctrader-* first and turn
# it on only after no project refreshes its own copy (docs/conventions.md § Secrets).
# ctrader_token_refresh = true
