# Deploys after CI passes on main{% if 'demo' in envs %}: demo first, then live{% endif %}.
# Put a required reviewer on the `live` GitHub Environment so live waits for your click.
# Repo variables: AWS_ACCOUNT_ID (required), AWS_REGION (optional, default eu-west-1).
# See platform docs/deployment.md.
name: Deploy

on:
  workflow_run:
    workflows: [CI]
    types: [completed]
    branches: [main]
  workflow_dispatch:
    inputs:
      environment:
        type: choice
        options: [{{ envs }}]

permissions:
  id-token: write
  contents: read

jobs:
{%- for env in envs.split(',') %}
  {{ env }}:
{%- if loop.first %}
    if: {% raw %}${{ (github.event_name == 'workflow_run' && github.event.workflow_run.conclusion == 'success') || inputs.environment == '{% endraw %}{{ env }}{% raw %}' }}{% endraw %}
{%- else %}
    needs: {{ loop.previtem }}
    if: {% raw %}${{ github.event_name == 'workflow_run' }}{% endraw %}
{%- endif %}
    uses: {{ github_owner }}/platform/.github/workflows/lambda-deploy.yml@{{ platform_version }}
    with:
      project: {{ slug }}
      environment: {{ env }}
      aws-account-id: {% raw %}${{ vars.AWS_ACCOUNT_ID }}{% endraw %}
      aws-region: {% raw %}${{ vars.AWS_REGION || 'eu-west-1' }}{% endraw %}
{%- endfor %}
{%- if 'demo' in envs %}

  # Manual live deploy (workflow_dispatch environment=live) without going through demo.
  live-manual:
    if: {% raw %}${{ github.event_name == 'workflow_dispatch' && inputs.environment == 'live' }}{% endraw %}
    uses: {{ github_owner }}/platform/.github/workflows/lambda-deploy.yml@{{ platform_version }}
    with:
      project: {{ slug }}
      environment: live
      aws-account-id: {% raw %}${{ vars.AWS_ACCOUNT_ID }}{% endraw %}
      aws-region: {% raw %}${{ vars.AWS_REGION || 'eu-west-1' }}{% endraw %}
{%- endif %}
